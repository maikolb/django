{
  "name": "hole-stars-neon",
  "version": "0.1.0",
  "description": "Hole Stars Neon — arcade 3D 'eat & grow' game (Three.js). Web + Android via Capacitor.",
  "private": true,
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "cap:init": "npx cap init \"Hole Stars\" com.gamefarm.holestars --web-dir=.",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  }
}
